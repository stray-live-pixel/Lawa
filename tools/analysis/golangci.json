{
  "version": "2",
  "run": { "tests": false, "timeout": "5m", "relative-path-mode": "wd" },
  "linters": {
    "default": "none",
    "enable": [
      "govet",
      "staticcheck",
      "errcheck",
      "ineffassign",
      "unused",
      "gocyclo",
      "gocognit"
    ],
    "settings": {
      "gocyclo": { "min-complexity": 16 },
      "gocognit": { "min-complexity": 15 }
    },
    "exclusions": { "generated": "strict", "presets": [] }
  },
  "issues": {
    "max-issues-per-linter": 0,
    "max-same-issues": 0,
    "uniq-by-line": false
  }
}
